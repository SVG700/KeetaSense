# Copy this file to .env and fill in the values you need.
# Never commit .env (it is in .gitignore).

# ---------- Backend ----------
# SQLite database file and media folder (relative to the project root)
KEETA_DB_PATH=backend/data/keetasense.db
KEETA_MEDIA_DIR=backend/data/media
# Frontend dev-server origins allowed by CORS (comma separated)
KEETA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Detector ----------
# Path to trained YOLOv8 weights. If the file does not exist, the system
# runs in "DEMO DETECTOR" mode (classical blob counting, clearly labelled).
KEETA_WEIGHTS=ml/weights/best.pt
# SAHI sliced inference settings
KEETA_SLICE_SIZE=640
KEETA_SLICE_OVERLAP=0.2
KEETA_CONF_THRESHOLD=0.25

# ---------- Telegram alerts (optional) ----------
# Create a bot with @BotFather and get your chat id from @userinfobot.
# If these are empty, alerts are written to the log instead of sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Which languages to send: en, kn or en,kn
ALERT_LANGUAGES=en,kn

# ---------- Edge device ----------
# 1 = mock hardware (laptop demo), 0 = real Raspberry Pi hardware
MOCK_HARDWARE=1
TRAP_ID=T1-polyhouse
BACKEND_URL=http://localhost:8000
# Seconds between cycles in demo mode (real mode advances once per day)
DEMO_CYCLE_SECONDS=20
# Stepper: BCM GPIO pins wired to ULN2003 IN1..IN4
STEPPER_PINS=17,18,27,22
# Half-steps needed to advance one tape section (calibrate on your trap)
STEPS_PER_SECTION=2048
# Seconds to wait after advancing before taking the photo (tape settles)
SETTLE_SECONDS=2
# DHT22 data pin (BCM numbering)
DHT22_PIN=4
